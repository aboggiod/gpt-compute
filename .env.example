# MCP Memory Server Configuration
# Copy this file to .env and update with your values

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
JWT_KEY=your-super-secret-key-change-this-in-production-min-32-chars-long
JWT_ISSUER=McpMemoryServer
JWT_AUDIENCE=McpMemoryClient

# Database Connection Strings
CONNECTION_STRING=Data Source=memory.db
VECTOR_STORE_CONNECTION=Data Source=vectors.db

# Session Configuration
SESSION_TIMEOUT_MINUTES=60

# FileSystem Configuration
FILESYSTEM_BASE_DIRECTORY=data
FILESYSTEM_ALLOWED_EXTENSIONS=.txt,.md,.json,.xml,.csv,.log,.pdf,.doc,.docx

# OAuth Client (for testing)
OAUTH_CLIENT_ID=chatgpt-client
OAUTH_CLIENT_SECRET=your-client-secret-here

# Server Configuration
ASPNETCORE_URLS=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development
